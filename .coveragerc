# Compatibility configuration for older coverage invocations, including
# the legacy CircleCI job that passes --cov-config .coveragerc.
# Keep these rules aligned with xcookie-generated [tool.coverage] settings
# in pyproject.toml. `source` is extra for standalone `coverage run`.

[run]
branch = True
source = mkinit

[report]
exclude_lines =
    pragma: no cover
    .*  # pragma: no cover
    .*  # nocover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if 0:
    if trace is not None
    verbose = .*
    ^ *raise
    ^ *pass *$
    if _debug:
    if __name__ == .__main__.:
    .*if six.PY2:
omit =
    mkinit/__main__.py
